#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SPARK_MANAGER_VERSION="3.1.0+20260916.4"
REPO_URL="https://github.com/sh1375/Spark.git"
SPARK_ROOT="/opt/spark"
SUPABASE_SOURCE="/opt/supabase-source"
SUPABASE_ROOT="/opt/spark-supabase"
CONFIG_DIR="/etc/spark"
MANAGER_CONF="${CONFIG_DIR}/manager.conf"
STATE_DIR="/var/lib/spark-manager"
STEP_DIR="${STATE_DIR}/steps"
LOG_DIR="/var/log/spark-manager"
BACKUP_DIR="/var/backups/spark"

C_RESET=$'\033[0m'
C_GREEN=$'\033[32m'
C_RED=$'\033[31m'
C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'
C_CYAN=$'\033[36m'
C_WHITE=$'\033[37m'
C_BOLD=$'\033[1m'
C_DIM=$'\033[2m'
CURRENT_LOG=""

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

mkdir -p "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"
chmod 700 "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink -- "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then SOURCE="$TARGET"; else SOURCE="${SOURCE_DIR}/${TARGET}"; fi
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
unset SOURCE SOURCE_DIR TARGET

for module in core install-base install-platform-a install-platform-b install-platform-c tests-backup update admin cleanup repair-override env-modern runtime-fixes studio-session install-livekit airgap airgap-target-patch airgap-auto airgap-ip airgap-dnsless-runtime; do
  module_path="${SCRIPT_DIR}/lib/${module}.sh"
  if [[ ! -r "$module_path" ]]; then
    printf 'Spark Air-Gap module missing: %s\n' "$module_path" >&2
    exit 1
  fi
  source "$module_path"
done
# Optional UI-only readiness-noise suppression. Keep it optional so older
# bootstrap scripts that do not yet download this helper can still install and
# smoke-test the Air-Gap backend safely.
module_path="${SCRIPT_DIR}/lib/airgap-observability-quiet.sh"
if [[ -r "$module_path" ]]; then
  source "$module_path"
fi
unset module module_path

# Final installation contract must load after all Air-Gap IP/DNSless overrides.
# This context is available even before a specific install action exports
# SPARK_AIRGAP_ACTIVE, so status/probe paths cannot fall back to Internet mode.
SPARK_AIRGAP_CONTEXT=1
source "${SCRIPT_DIR}/lib/installation-universal.sh"

spark_airgap_supabase_clone() {
  local destination="${@: -1}" attempt rc=1
  local -a reference_args=()
  [[ -n "$destination" && "$destination" != "/" ]] || { fail "Unsafe Supabase clone destination."; return 2; }
  if [[ -d "${SUPABASE_SOURCE}/.git" ]]; then
    reference_args=(--reference-if-able "$SUPABASE_SOURCE" --dissociate)
    info "Using local Supabase objects as a clone accelerator; the snapshot will remain self-contained."
  fi
  for attempt in 1 2 3 4; do
    rm -rf -- "$destination"
    info "Supabase clone attempt ${attempt}/4 (Git HTTP/1.1)."
    set +e
    GIT_TERMINAL_PROMPT=0 command git -c http.version=HTTP/1.1 clone "${reference_args[@]}" "${@:2}"
    rc=$?
    set -e
    if (( rc == 0 )); then
      command git -C "$destination" rev-parse --verify HEAD >/dev/null 2>&1 || rc=1
      if (( rc == 0 )); then command git -C "$destination" fsck --connectivity-only >/dev/null 2>&1 || rc=1; fi
      (( rc == 0 )) && return 0
    fi
    rm -rf -- "$destination"
    if (( attempt < 4 )); then warn "Supabase clone was interrupted; retrying after $((attempt * 3)) seconds."; sleep $((attempt * 3)); fi
  done
  fail "Supabase clone failed after 4 attempts. Check the builder host connection to github.com."
  return "${rc:-1}"
}

git() {
  local arg
  if [[ "${1:-}" == "clone" ]]; then
    for arg in "$@"; do
      if [[ "$arg" == "https://github.com/supabase/supabase.git" ]]; then spark_airgap_supabase_clone "$@"; return $?; fi
    done
  fi
  command git "$@"
}

docker() {
  local attempt rc=1 retryable=0
  if [[ "${1:-}" == "pull" ]]; then retryable=1
  elif [[ "${1:-}" == "buildx" && "${2:-}" == "imagetools" && "${3:-}" == "inspect" ]]; then retryable=1
  fi
  if (( retryable == 0 )); then command docker "$@"; return $?; fi
  for attempt in 1 2 3 4; do
    if command docker "$@"; then return 0; else rc=$?; fi
    if (( attempt < 4 )); then printf '! Docker registry operation failed (attempt %d/4); retrying after %d seconds.\n' "$attempt" "$((attempt * 3))" >&2; sleep $((attempt * 3)); fi
  done
  return "$rc"
}

spark_airgap_sync_source_main() {
  local branch local_head remote_head origin_url
  [[ -d "${SPARK_ROOT}/.git" ]] || { fail "Spark source repository is required at ${SPARK_ROOT}."; return 1; }
  branch="$(command git -C "$SPARK_ROOT" branch --show-current 2>/dev/null || true)"
  [[ "$branch" == "main" ]] || { fail "Spark source must be on branch main before building an Air-Gap bundle."; return 1; }
  [[ -z "$(command git -C "$SPARK_ROOT" status --porcelain 2>/dev/null)" ]] || { fail "Spark source has uncommitted changes; refusing to update or build the bundle."; return 1; }
  origin_url="$(command git -C "$SPARK_ROOT" remote get-url origin 2>/dev/null || true)"
  [[ "$origin_url" == "https://github.com/sh1375/Spark.git" || "$origin_url" == "git@github.com:sh1375/Spark.git" ]] || { fail "Unexpected Spark origin remote: ${origin_url:-missing}"; return 1; }
  info "Synchronizing clean Spark main before Air-Gap bundle generation."
  GIT_TERMINAL_PROMPT=0 command git -c http.version=HTTP/1.1 -C "$SPARK_ROOT" fetch --prune origin main || { fail "Unable to fetch the latest Spark main branch."; return 1; }
  local_head="$(command git -C "$SPARK_ROOT" rev-parse HEAD)"
  remote_head="$(command git -C "$SPARK_ROOT" rev-parse FETCH_HEAD)"
  if [[ "$local_head" == "$remote_head" ]]; then ok "Spark source is already current at ${local_head:0:12}."; return 0; fi
  if ! command git -C "$SPARK_ROOT" merge-base --is-ancestor "$local_head" "$remote_head"; then fail "Local Spark main has diverged from origin/main; refusing to reset it automatically."; return 1; fi
  command git -C "$SPARK_ROOT" merge --ff-only "$remote_head" >/dev/null || { fail "Unable to fast-forward Spark main to the fetched revision."; return 1; }
  ok "Spark source fast-forwarded to ${remote_head:0:12}."
}

spark_airgap_backend_prepare() {
  clear_screen() { :; }
  title() { printf '\n%s%s== Spark Air-Gapped task ==%s %s\n' "$C_BOLD" "$C_CYAN" "$C_RESET" "$(date -Is)"; }
  pause() { :; }
}

spark_airgap_validate_action() {
  title
  new_log "airgap-validate"
  local input="${1:-}" staging="" root
  [[ -n "$input" ]] || read -r -p "Path to Spark air-gap .tar.gz or extracted bundle directory: " input
  [[ -n "$input" ]] || { fail "Bundle path is required."; return 1; }
  if [[ -d "$input" ]]; then root="$(readlink -f "$input")"; else staging="$(mktemp -d)"; root="$(airgap_extract_bundle_archive "$input" "$staging")" || { rm -rf "$staging"; return 1; }; fi
  if ! airgap_validate_bundle_dir "$root"; then [[ -n "$staging" ]] && rm -rf "$staging"; return 1; fi
  printf 'Bundle target: Ubuntu %s / %s\n' "$(airgap_meta_from "$root" UBUNTU_VERSION)" "$(airgap_meta_from "$root" ARCH)"
  if airgap_validate_target_compatibility "$root" >/dev/null 2>&1; then ok "Air-gap bundle integrity is valid and this host matches the target platform."; else warn "Bundle integrity is valid; this host does not match the bundle target, so target compatibility will be enforced during import/bootstrap."; fi
  [[ -n "$staging" ]] && rm -rf "$staging"
  return 0
}

spark_airgap_dispatch_inner() {
  local action="$1"; shift || true
  case "$action" in
    airgap-build)
      local loaded_commit
      loaded_commit="$(command git -C "$SPARK_ROOT" rev-parse HEAD)" || return 1
      spark_airgap_sync_source_main || return 1
      if [[ "$loaded_commit" != "$(command git -C "$SPARK_ROOT" rev-parse HEAD)" \
          || "$(readlink -f "$SCRIPT_DIR")" != "$(readlink -f "${SPARK_ROOT}/deploy/spark-cli")" ]]; then
        # Modules were sourced before fetch. Run the updated entrypoint so the
        # embedded source revision and the executing builder stay consistent.
        bash "${SPARK_ROOT}/deploy/spark-cli/spark-airgap" --build
      else
        airgap_build_bundle
      fi
      ;;
    airgap-validate) spark_airgap_validate_action "${1:-}" ;;
    airgap-import) airgap_import_bundle "${1:-}" ;;
    airgap-step) airgap_install_one_step "${1:-}" ;;
    airgap-install-all) airgap_install_all ;;
    airgap-status) airgap_status ;;
    airgap-build-target-patch) airgap_build_target_patch "${1:-}" "${2:-}" "${3:-}" ;;
    airgap-apply-target-patch) airgap_apply_target_patch "${1:-}" "${2:-}" ;;
    airgap-auto-target-bootstrap) airgap_auto_apply_and_bootstrap "${1:-}" "${2:-}" ;;
    airgap-build-observability-pack) airgap_build_observability_pack "${1:-}" ;;
    airgap-import-observability-pack) airgap_import_observability_pack "${1:-}" ;;
    airgap-build-edge-functions-pack) airgap_build_edge_functions_pack "${1:-}" "${2:-}" ;;
    airgap-import-edge-functions-pack) airgap_import_edge_functions_pack "${1:-}" ;;
    *) fail "Unknown Spark Air-Gap backend action: $action"; return 2 ;;
  esac
}

spark_airgap_backend_action() {
  local action="${1:-}"; shift || true
  [[ -n "$action" ]] || { printf 'Air-gap backend action is required.\n' >&2; return 2; }
  spark_airgap_backend_prepare
  printf 'SPARK_ACTION_BEGIN %s %s\n' "$action" "$(date -Is)"
  local rc=0
  set +e
  ( set -Eeuo pipefail; spark_airgap_dispatch_inner "$action" "$@" )
  rc=$?
  set -e
  printf 'SPARK_ACTION_END %s rc=%d %s\n' "$action" "$rc" "$(date -Is)"
  return "$rc"
}

case "${1:-}" in
  --version|-V) printf 'Spark Air-Gapped Installer %s\n' "$SPARK_MANAGER_VERSION" ;;
  --backend-action) shift; spark_airgap_backend_action "$@" ;;
  --build) spark_airgap_backend_action airgap-build ;;
  --validate) shift; spark_airgap_backend_action airgap-validate "${1:-}" ;;
  --import) shift; spark_airgap_backend_action airgap-import "${1:-}" ;;
  --step) shift; spark_airgap_backend_action airgap-step "${1:-}" ;;
  --install-all) spark_airgap_backend_action airgap-install-all ;;
  --status) spark_airgap_backend_action airgap-status ;;
  --build-target-patch) shift; spark_airgap_backend_action airgap-build-target-patch "${1:-}" "${2:-}" "${3:-}" ;;
  --apply-target-patch) shift; spark_airgap_backend_action airgap-apply-target-patch "${1:-}" "${2:-}" ;;
  --auto-target-bootstrap) shift; spark_airgap_backend_action airgap-auto-target-bootstrap "${1:-}" "${2:-}" ;;
  --build-observability-pack) shift; spark_airgap_backend_action airgap-build-observability-pack "${1:-}" ;;
  --import-observability-pack) shift; spark_airgap_backend_action airgap-import-observability-pack "${1:-}" ;;
  --build-edge-functions-pack) shift; spark_airgap_backend_action airgap-build-edge-functions-pack "${1:-}" "${2:-}" ;;
  --import-edge-functions-pack) shift; spark_airgap_backend_action airgap-import-edge-functions-pack "${1:-}" ;;
  --help|-h|"")
    cat <<'EOF_HELP'
Usage: spark-airgap [option]

  --build                                      Build a complete offline bundle on a connected staging host
  --validate [bundle]                          Validate bundle structure and target compatibility
  --import [bundle]                            Import bundle and load all Docker images locally
  --step [1-17|19-22]                         Run one installation step in internal-IP offline mode
  --install-all                                Run the complete 21-step IP-only installation (no firewall changes)
  --status                                     Show active bundle and internal IPv4 service endpoints
  --build-target-patch [base] [os]             Build a small Ubuntu target patch
  --apply-target-patch [base] [patch]          Apply a verified target patch
  --auto-target-bootstrap [base] [patch]       Auto-discover and bootstrap an offline target
  --build-observability-pack [output]          Build only Step 22 observability images
  --import-observability-pack [pack]           Import observability image supplement
  --build-edge-functions-pack [base] [output]  Build a small offline Edge Functions supplement from an existing base bundle
  --import-edge-functions-pack [pack]          Import Edge Functions supplement, restart functions and validate cold start
  --version                                    Show air-gap installer version
EOF_HELP
    ;;
  *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
esac
